# Copy to .env and fill in. Never commit .env.

# ---------- Data source ----------
# postgres = read/write the PostgreSQL database below
# parquet  = work fully offline with files in data/ (no database needed)
DATA_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oads_db
DB_USER=postgres
DB_PASSWORD=change-me

# ---------- Embeddings ----------
# provider: sentence-transformers | ollama | openai | gemini | hash (tests only)
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=64

# ---------- Reranker ----------
# cross-encoder: ncbi/MedCPT-Cross-Encoder (medical, best in our tests), cross-encoder/ms-marco-MiniLM-L-6-v2 (fast), or "none"
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder

# ---------- Answer LLM ----------
# provider: ollama | anthropic | openai | gemini | groq | openrouter | nvidia | bedrock
# AWS Bedrock example: LLM_PROVIDER=bedrock, LLM_MODEL=us.amazon.nova-lite-v1:0 (model ids: Bedrock console > Model catalog)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b

# ---------- Judge LLM for evaluation (use a different, stronger model) ----------
# NVIDIA's free API credits judge a full evaluation in minutes; the Gemini free tier allows only ~10 judge calls a day.
JUDGE_PROVIDER=nvidia
JUDGE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# ---------- Provider endpoints / keys ----------
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Free tiers: Gemini (aistudio.google.com), Groq (console.groq.com), OpenRouter ':free' models (openrouter.ai),
# NVIDIA API catalog (build.nvidia.com > Get API Key; the account must be allowed to run models, or calls return 403)
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# ---------- Retrieval ----------
TOP_K=8
CANDIDATES=60
RERANK_POOL=30
RERANK_BLEND=fuse
# AWS Bedrock: credentials come from `aws configure` / AWS_PROFILE / an IAM role, never from this file
AWS_REGION=us-east-1
AWS_PROFILE=
